 "cards": [
  {
   "dot": "emerald",
   "title": "Two lanes, one table",
   "items": [
    "Offline: seed docs are chunked by heading, embedded and written per source in one transaction (delete then insert), so re-running ingest is safe",
    "Online: the retriever embeds the query, the store orders by cosine and scores 1 - distance, and hits under 0.35 are dropped, so an off-topic query returns nothing"
   ]
  },
  {
   "dot": "orange",
   "title": "Evals measure the floor",
   "items": [
    "The harness retrieves once per question with no floor, then sweeps 11 floors (0.00 to 0.50) over the saved scores",
    "It reports hit@k, MRR and off-topic rejection per floor; this is what justifies 0.35 (ADR-0012)",
    "The report prints and never fails CI"
   ]
  },
  {
   "dot": "rose",
   "title": "Not built yet",
   "items": [
    "No end-to-end agent or prompt eval: evals/datasets/airline_claims.jsonl is empty, though prompt versioning depends on one",
    "Embedding-provider outages surface to the agent as a tool error result"
   ]
  }
 ]
