 "cards": [
  {
   "dot": "cyan",
   "title": "Order matters",
   "items": [
    "Guards run before any model call",
    "Rules code, not the LLM, computes the amount",
    "The verdict is verified before it is returned"
   ]
  },
  {
   "dot": "rose",
   "title": "Two moments",
   "items": [
    "Triage only submits a pending request",
    "A human approval later runs the executor once",
    "OPA can deny at submit, so no request exists",
    "A failed executor stays approved; /execute retries"
   ]
  },
  {
   "dot": "amber",
   "title": "Cross-cutting",
   "items": [
    "Every tool call, policy verdict and approval is audited",
    "OpenTelemetry spans cover LLM turns, tools, policy",
    "Dashed: memory is optional, needs a claimant id"
   ]
  }
 ]
