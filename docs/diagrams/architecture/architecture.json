  "cards": [
    {
      "dot": "rose",
      "title": "Core claim",
      "items": [
        "LLM chooses how to investigate; rules and humans decide outcomes",
        "State changes only run after approval, exactly once"
      ]
    },
    {
      "dot": "cyan",
      "title": "Deployed with Docker Compose",
      "items": [
        "db: pgvector/pgvector:pg16, opa: policy server",
        "migrate-ingest: one-shot migrations + KB ingest",
        "api: FastAPI on 127.0.0.1:8000, MCP spawned over stdio"
      ]
    },
    {
      "dot": "emerald",
      "title": "Built in Week 4",
      "items": [
        "OPA/Rego payout policy denies at submit, fails closed (ADR-0015)",
        "Append-only audit log at dispatch, policy and approvals (ADR-0016)",
        "OpenTelemetry spans, exporter off by default (ADR-0017)"
      ]
    },
    {
      "dot": "amber",
      "title": "Hardened in Week 5",
      "items": [
        "Separate triage and approver bearer tokens; approver comes from config (ADR-0019)",
        "Ports bind to 127.0.0.1 and the DB password has no default",
        "A failed execution stays approved; POST /approvals/{id}/execute retries it"
      ]
    }
  ]
