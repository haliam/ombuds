 "cards": [
  {
   "dot": "rose",
   "title": "Trust boundaries",
   "items": [
    "Input: injection is screened first; a hit returns an escalated result and the model, provider and tools are never touched (ADR-0014)",
    "PII is redacted before the model sees the claim, again in tool-call arguments, and again in the answer, explanation and escalation reason (ADR-0013)",
    "Tool results are not filtered"
   ]
  },
  {
   "dot": "emerald",
   "title": "Where the model's authority ends",
   "items": [
    "The agent is offered search_kb, check_eligibility and log_claim only; issue_payment stays operator-only over MCP",
    "Any claim_id the model passes is overwritten with the server-issued one",
    "log_claim recomputes eligibility with the rules engine and only submits a payload-bound approval request; nothing executes until a human approves",
    "An OPA/Rego policy checks every submit and refuses a payout above the cap; if OPA is down it denies (ADR-0015)"
   ]
  },
  {
   "dot": "orange",
   "title": "Not built yet",
   "items": [
    "Streamed tool-call arguments are redacted per event (_redact_event)"
   ]
  }
 ]
