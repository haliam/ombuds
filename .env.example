ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Embedding model for RAG; must emit 1536 dims to match kb_chunks.embedding (a new model needs a migration)
EMBEDDING_MODEL=text-embedding-3-small
# Postgres + pgvector (docker compose `db` service); embeddings live in the same database, see ADR-0010
# Required: compose refuses to start without POSTGRES_PASSWORD, and the app refuses to start without DATABASE_URL.
# Pick a password (URL-safe characters only, it is embedded in DATABASE_URL) and use it in both lines.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://ombuds:change-me@localhost:5433/ombuds
# (docker compose builds its own DATABASE_URL for the containers from POSTGRES_PASSWORD; keys are read from this .env)
# Set to 1 only for a throwaway local database: lets the app fall back to postgresql://ombuds:ombuds@localhost:5433/ombuds
# OMBUDS_ALLOW_DEV_DEFAULTS=1
DATABASE_POOL_MAX_SIZE=10
ANTHROPIC_MODEL=claude-sonnet-5
# Cheaper/faster model the triage provider falls back to once ANTHROPIC_MODEL exhausts its retries
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5
# Per-request timeout and SDK-level retry count (exponential backoff), before falling back models
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_RETRIES=2
# Live prompt version per feature, see AGENTS.md "Prompt versioning"
CLAIMS_TRIAGE_PROMPT_VERSION=v4
# OPA policy server (ADR-0015) and the payout ceiling: payments above it are denied at submit. Docker compose overrides OPA_URL.
OPA_URL=http://localhost:8181
OPA_TIMEOUT_SECONDS=2
PAYOUT_LIMIT_EUR=400
# Tracing exporter (ADR-0017): none | console (stderr) | otlp (set OTEL_EXPORTER_OTLP_ENDPOINT, e.g. http://localhost:4318)
OTEL_TRACES_EXPORTER=none
# Max output tokens per model turn
ANTHROPIC_MAX_TOKENS=1024
# LLM spend caps, per process (ADR-0018): a turn is refused (HTTP 429) once either is reached. Also set a spend limit in the provider console.
LLM_BUDGET_MAX_USD=1.00
LLM_BUDGET_MAX_TOKENS=500000
