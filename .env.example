ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Embedding model for RAG; must emit 1536 dims to match kb_chunks.embedding (a new model needs a migration)
EMBEDDING_MODEL=text-embedding-3-small
# Postgres + pgvector (docker compose `db` service); embeddings live in the same database, see ADR-0010
DATABASE_URL=postgresql://ombuds:ombuds@localhost:5433/ombuds
# (docker compose overrides DATABASE_URL to the `db` service for its containers; keys are read from this .env)
DATABASE_POOL_MAX_SIZE=10
ANTHROPIC_MODEL=claude-sonnet-5
# Cheaper/faster model the triage provider falls back to once ANTHROPIC_MODEL exhausts its retries
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5
# Per-request timeout and SDK-level retry count (exponential backoff), before falling back models
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_RETRIES=2
# Live prompt version per feature, see AGENTS.md "Prompt versioning"
CLAIMS_TRIAGE_PROMPT_VERSION=v4
# OPA policy server (ADR-0015) and the payout ceiling: payments above it are denied at submit. Docker compose overrides OPA_URL.
OPA_URL=http://localhost:8181
OPA_TIMEOUT_SECONDS=2
PAYOUT_LIMIT_EUR=400
